// =============================================================================
// configs/cluster.config - adapted for Sherlock (SLURM), from the real
// LSF-based template shipped in distiller-nf's DSL2 branch.
//
// This should REPLACE the contents of:
//   $GROUP_HOME/distiller-nf/configs/cluster.config
// (back up the original first if you want to diff against it later).
// =============================================================================

process {
    // Our HPC uses SLURM, not LSF - this is the one change that matters most. 
    //Change executer to 'pbs' or 'lsf' according to your cluster
    executor = 'slurm'
    memory = '8 GB'
    maxRetries = 2
    errorStrategy = 'retry'

    // TODO: replace with your actual HPC account
    //   sacctmgr show assoc user=$USER format=account,partition
    //   sh_part
    // The placeholder below WILL fail with "Invalid account or
    // account/partition combination specified" until replaced.
    clusterOptions = '--account=ximenac'

    // TODO: replace 'normal' with your group's owned partition 
    // (or other relevant HPC partition) if you have
    // one; 'normal' is the general-access queue otherwise. Same
    // attempt-based escalation pattern as the original LSF config, just
    // using Sherlock partition names instead of LSF 'short'/'long' queues.
    queue = 'normal'
    time = { task.attempt<=1 ? '14h' : '23h' }

    // Sorting/temp files - point at scratch, not the current directory
    // (the original default './' would land wherever you launch from,
    // which is risky at this data scale)
    distillerTmpDir = "${System.getenv('SCRATCH')}/distiller_tmp"

    // ---------------------------------------------------------------------
    // Per-process resources. Names below are the REAL process names
    // confirmed from modules/local/*.nf in this repo - verify any process
    // not listed here still exists under the same name if you hit an
    // "unknown process" warning.
    // ---------------------------------------------------------------------
    withName: download_sra {
        cpus = 2
        maxForks = 15
    }
    withName: download_truncate_chunk_fastqs {
        maxForks = 10
        cpus = 4
        memory = '2 GB'
        queue = 'normal'
        time = '2h'
    }
    withName: local_truncate_chunk_fastqs {
        cpus = 6
        memory = '2 GB'
    }
    withName: fastqc {
        cpus = 4
        memory = '4 GB'
        queue = 'normal'
        time = '2h'
    }
    // Alignment - one job per chunk (your 117 runs x chunksize:30000000 from
    // project.yml will fan out into several chunks per run)
    withName: map_parse_sort_chunks {
        cpus = 16          // bumped from the template's 8 - bwa mem scales
                            // well with threads and this is your biggest
                            // compute cost at 3.4B read pairs
        memory = '32 GB'
        time = { task.attempt<=1 ? '24h' : '48h' }
    }
    withName: sort_group {
        cpus = 8
        memory = '24 GB'
        clusterOptions = '--account=xyz'
        time = { task.attempt==1 ? '16h' : '23h' }
    }
    withName: dedup_group {
        cpus = 8
        memory = '32 GB'
        clusterOptions = '--account=xyz'
        time = { task.attempt==1 ? '24h' : '48h' }
    }
    withName: merge_dedup_final {
        cpus = 12
        memory = '48 GB'
        clusterOptions = '--account=xyz --qos=long'
        time = { task.attempt==1 ? '4d' : '6d' }
    }
    withName: bin_zoom_library_pairs {
        cpus = 8
        memory = '64 GB'   // bumped for the 500bp base resolution - finer
                            // bins mean a bigger sparse matrix to build
        clusterOptions = '--account=xyz'                    
        time = { task.attempt==1 ? '12h' : '1d' }                     
    }
    withName: merge_zoom_library_group_coolers {
        cpus = 8
        memory = '32 GB'
        clusterOptions = '--account=xyz'                    
        time = { task.attempt==1 ? '12h' : '1d' }  
    }
    //
    // withName: merge_stats_libraries_into_groups
    // { use defaults }
    //
    
        // MULTIQC: distiller_env.sif doesn't bundle multiqc, and the module's
    // own container directive is commented out / points at an unofficial
    // fork. Simplest fix: use Sherlock's own multiqc module instead of any
    // container for this one process specifically.
    // TODO: replace with the exact version string from `module spider multiqc`
    withName: MULTIQC {
        container = null
        module = 'biology:py-multiqc/1.30_py312'
    }
}

// -----------------------------------------------------------------------------
// Apptainer/Singularity - Sherlock has this built in natively. Enable it and
// point at the .sif we built earlier.
// -----------------------------------------------------------------------------
singularity {
    enabled = true
    // TODO: confirm this matches where install_distiller.sh actually put it
    runOptions = "--bind ${System.getenv('SCRATCH')},${System.getenv('OAK') ?: ''} --env PYTHONNOUSERSITE=1"
    autoMounts = true
}
process.container = "${System.getenv('GROUP_HOME')}/distiller-nf/distiller_env.sif"

docker {
    enabled = false
}